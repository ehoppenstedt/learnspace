# Copy to .env for local development. Every value here is read from the environment.
DEBUG=1
SECRET_KEY=change-me
DATABASE_URL=postgis://learnspace:learnspace@localhost:5432/learnspace
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,192.168.1.10
PUBLIC_BASE_URL=http://localhost:8000

# Brand / legal (placeholders until the legal entity is final)
BRAND_NAME=learnspace
LEGAL_ENTITY_NAME=RAZON SOCIAL PENDIENTE
LEGAL_RFC=RFC_PENDIENTE

# Field encryption: "kid:<base64 32 bytes>", first key encrypts. Generate with:
#   python -c "import os,base64;print('k1:'+base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEYS=

# Media: "local" for dev, "s3" for any S3-compatible bucket (Cloudflare R2 recommended)
MEDIA_STORAGE=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# SMS: console backend prints OTP codes to the server log in development.
SMS_BACKEND=apps.accounts.sms.ConsoleSMSBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Sign in with Apple / Google: comma-separated client ids (audiences)
APPLE_CLIENT_IDS=com.learnspace.app
GOOGLE_CLIENT_IDS=

SENTRY_DSN=
FEATURE_ONLINE_EXPERIENCES=0
